
<group name="windows, firewall, network_scan">

  <rule id="100001" level="5">
    <if_sid>600000</if_sid>
    <field name="win.system.eventID">^5152$|^5157$</field>
    <description>Windows Firewall dropped a packet.</description>
  </rule>

  <rule id="100002" level="7">
    <if_sid>100001</if_sid>
    <field name="win.eventdata.sourceAddress">^192\.168\.30\.6$</field>
    <description>Windows Firewall DROP event from Kali Linux IP 192.168.30.6</description>
  </rule>

  <rule id="100100" level="10" frequency="5" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>Repeated Windows failed logons detected - possible brute-force activity.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

</group>
